<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_amoled"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="18dp"
    android:paddingTop="14dp"
    android:paddingRight="16dp"
    android:paddingBottom="14dp">

    <!-- Left telemetry & status stack -->
    <LinearLayout
        android:id="@+id/widget_info_area"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingEnd="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:letterSpacing="0.06"
                android:maxLines="1"
                android:text="J.A.R.V.I.S."
                android:textColor="#F5F5F7"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_status_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/widget_pill_bg"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingLeft="8dp"
                android:paddingTop="2dp"
                android:paddingRight="8dp"
                android:paddingBottom="2dp"
                android:text="85% · Wi-Fi"
                android:textColor="#F0B44C"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_wake_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Say &quot;Hey Jarvis&quot;"
            android:textColor="#9A9AA4"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_reminder_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:background="@drawable/widget_pill_bg"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingLeft="10dp"
            android:paddingTop="5dp"
            android:paddingRight="10dp"
            android:paddingBottom="5dp"
            android:text="All systems nominal"
            android:textColor="#D4D4DC"
            android:textSize="11.5sp" />
    </LinearLayout>

    <!-- Right 1-tap Stark Voice Orb button -->
    <FrameLayout
        android:id="@+id/widget_orb_button"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:background="@drawable/widget_orb_bg"
        android:contentDescription="Wake Jarvis">

        <ImageView
            android:id="@+id/widget_orb_icon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:contentDescription="Speak to Jarvis"
            android:src="@drawable/ic_widget_wave" />
    </FrameLayout>

</LinearLayout>
